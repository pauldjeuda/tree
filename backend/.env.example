NODE_ENV=development
PORT=4000

# Base de données : sqlite (développement, aucun service à installer) ou mysql (recommandé en production)
DB_DIALECT=sqlite
DB_STORAGE=./data/tree.sqlite
# Pour MySQL (docker compose up -d lance une base compatible) :
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=tree_db
# DB_USER=tree_user
# DB_PASSWORD=tree_password
# DB_SSL=true
# DB_POOL_MAX=3

# En production : DB_DIALECT=mysql, et PUBLIC_APP_URL / CORS_ORIGIN / DB_PASSWORD obligatoires (le serveur refuse de démarrer sinon).

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# En développement le front passe par le proxy Vite, donc rien d'autre n'est nécessaire.
CORS_ORIGIN=http://localhost:5173
# URL publique du front : sert à construire le lien de partage et le lien d'édition
PUBLIC_APP_URL=http://localhost:5173
# URL publique de l'API : à renseigner seulement si le front et l'API sont sur deux domaines
PUBLIC_API_URL=

UPLOAD_DIR=./uploads
# Vercel Blob : un store relié au projet fournit BLOB_STORE_ID (OIDC); hors Vercel, utiliser le jeton RW.
# BLOB_STORE_ID=store_xxxxxxxxxxxxxxxx
# BLOB_READ_WRITE_TOKEN=

# Nombre de proxys de confiance devant l'API : 0 en local, 1 derrière nginx ou un hébergeur (Render, Railway…).
# Indispensable en production : sinon la limitation de débit s'applique à l'IP du proxy pour tous les utilisateurs.
TRUST_PROXY=0

# Applique les migrations au démarrage (true en développement, false conseillé en production : lancez npm run db:migrate)
AUTO_MIGRATE=true
LOG_LEVEL=info
