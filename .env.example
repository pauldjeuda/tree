# Variables lues par docker-compose.yml (production). Copiez ce fichier en .env et remplissez-le.

# Adresse publique du site, telle que tapée dans le navigateur (sert aux liens de partage et à CORS)
PUBLIC_APP_URL=https://tree.exemple.com

# Mots de passe de la base (longs et uniques)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Facultatif
# DB_NAME=tree_db
# DB_USER=tree_user
# HTTP_PORT=80
# Nombre de proxys devant le backend : 1 = le nginx du conteneur frontend seul ;
# 2 = un autre proxy/load balancer (Cloudflare, Traefik, Caddy…) devant ce nginx
# TRUST_PROXY=1
