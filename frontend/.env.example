# URL de l'API vue par le NAVIGATEUR.
#  - /api/v1                      : site et API sur le même domaine (nginx du Dockerfile, ou proxy Vite en développement)
#  - https://api.exemple.com/api/v1 : API sur un autre domaine (Vercel/Netlify + Render/Railway…)
# Cette valeur est inscrite dans le site au moment du build (npm run build).
VITE_API_URL=/api/v1

# Développement uniquement : adresse du backend vers laquelle le proxy Vite redirige /api
# VITE_DEV_API_TARGET=http://localhost:4000
